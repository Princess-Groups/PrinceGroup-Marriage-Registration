# Supabase — copy to .env and fill in your values (never commit .env)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
# Server-side only. Never VITE_-prefixed — it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Razorpay — server-side only (Razorpay dashboard → Settings → API Keys).
# Never VITE_-prefixed so the key secret never reaches the browser.
RAZORPAY_KEY_ID=<key id, e.g. rzp_test_...>
RAZORPAY_KEY_SECRET=<key secret>
